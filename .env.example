# Copy this file to .env and adjust as needed.
# Every setting has a safe local default in config/settings.py,
# so a .env file is optional for local development.

# --- Core ---
SECRET_KEY=change-me-to-a-long-random-string-at-least-fifty-characters-long
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
# Comma-separated HTTPS origins for production CSRF, e.g. https://example.com
CSRF_TRUSTED_ORIGINS=

# --- Database ---
# Prefer DATABASE_URL on hosted platforms (Railway, Render, Heroku).
# DATABASE_URL=postgres://user:password@host:5432/portfolio
#
# Or set DB_ENGINE=postgres and the discrete fields below.
DB_ENGINE=
DB_NAME=portfolio
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- Production security (used when DEBUG=False) ---
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000

# --- Email (optional) ---
# Only needed if you add email-sending features later. Defaults to console output.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@example.com
