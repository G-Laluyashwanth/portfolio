# Copy this file to .env and adjust as needed.
# Every setting has a safe local default in config/settings.py,
# so a .env file is optional for local development.

# --- Core ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# --- Database ---
# Leave DB_ENGINE blank to use SQLite (default). Set it to "postgres" to use PostgreSQL.
DB_ENGINE=
DB_NAME=portfolio
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# --- Email (optional) ---
# Only needed if you add email-sending features later. Defaults to console output.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@example.com
CONTACT_RECIPIENT=you@example.com
